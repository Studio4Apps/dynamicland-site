# Explicit mode: local, preview, production. NODE_ENV is not a publishing switch.
SITE_ENV=local
# Owner-approved HTTPS origin, without path. No assumed deployment hostname.
SITE_ORIGIN=
# Set only after website-specific privacy/terms text is approved and added.
LEGAL_APPROVED=false
# Training policy is independent of search discovery: block or allow.
TRAINING_CRAWLERS=block
